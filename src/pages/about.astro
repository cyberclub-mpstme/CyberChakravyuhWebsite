---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us — Cyber Chakravyuh" activePage="about">

  <!-- Hero -->
  <section class="hero-inner">
    <div class="container">
      <div class="section-label">WHO WE ARE</div>
      <h1 class="hero-title">About Cyber Chakravyuh</h1>
      <p class="hero-subtitle">NMIMS MPSTME's first and only cybersecurity club, dedicated to fostering cyber awareness, ethical hacking, and digital defense skills.</p>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section">
    <div class="container two-col">
      <div class="card">
        <!-- <div class="card-icon">🎯</div> -->
        <h3 class="card-title">Mission</h3>
        <p class="card-text">Empowering students with practical cybersecurity skills and knowledge to navigate the digital world safely.</p>
      </div>
      <div class="card">
        <!-- <div class="card-icon">🔭</div> -->
        <h3 class="card-title">Vision</h3>
        <p class="card-text">Creating India's most active college cybersecurity community and producing top-tier security professionals.</p>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header center">
        <h2 class="section-title">What We Do</h2>
      </div>
      <div class="three-col mt-24">
        <div class="card">
          <!-- <div class="card-icon">🚩</div> -->
          <h3 class="card-title">CTF Competitions</h3>
          <p class="card-text">Regular Capture The Flag events to test and improve practical hacking skills.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">💻</div> -->
          <h3 class="card-title">Workshops & Training</h3>
          <p class="card-text">Hands-on sessions on various cybersecurity domains and tools.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">🎤</div> -->
          <h3 class="card-title">Guest Lectures</h3>
          <p class="card-text">Insights from industry experts and seasoned security professionals.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">🔍</div> -->
          <h3 class="card-title">Security Research</h3>
          <p class="card-text">Collaborative research projects exploring new vulnerabilities and defenses.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">🛡️</div> -->
          <h3 class="card-title">Awareness Campaigns</h3>
          <p class="card-text">Spreading knowledge about digital safety and privacy best practices.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">⚡</div> -->
          <h3 class="card-title">Hackathons</h3>
          <p class="card-text">Building secure solutions and innovating in the cybersecurity space.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2 class="section-title">Core Values</h2>
      </div>
      <div class="three-col mt-24">
        <div class="card">
          <!-- <div class="card-icon">🤝</div> -->
          <h3 class="card-title">Integrity</h3>
          <p class="card-text">Upholding the highest ethical standards in all our security practices and research.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">💡</div> -->
          <h3 class="card-title">Innovation</h3>
          <p class="card-text">Continuously exploring new techniques and solutions to stay ahead of threats.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">🔗</div> -->
          <h3 class="card-title">Collaboration</h3>
          <p class="card-text">Working together and sharing knowledge to build a stronger security community.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">⭐</div> -->
          <h3 class="card-title">Excellence</h3>
          <p class="card-text">Striving for perfection and deep technical understanding in our work.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">🧠</div> -->
          <h3 class="card-title">Curiosity</h3>
          <p class="card-text">Maintaining a constant desire to learn how systems work and how they can be secured.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--alt">
    <div class="container">
      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-number" data-count="2024" data-suffix="">2024</div>
          <div class="stat-label">Founded</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="50" data-suffix="+">50+</div>
          <div class="stat-label">Members</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="6" data-suffix="">6</div>
          <div class="stat-label">Departments</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="5" data-suffix="+">5+</div>
          <div class="stat-label">Events</div>
        </div>
      </div>
    </div>
  </section>

</Layout>
