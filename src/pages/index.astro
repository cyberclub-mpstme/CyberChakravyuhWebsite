---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();
now.setHours(0, 0, 0, 0);

const upcomingEvents = allEvents
  .filter(e => new Date(e.data.date).getTime() >= now.getTime())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 2);
---

<Layout title="Cyber Chakravyuh — NMIMS MPSTME's Premier Cybersecurity Club" activePage="home">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="container">
      <div class="hero-badge">NMIMS MPSTME's First Cybersecurity Club</div>
      <h1 class="hero-title">Defending the Digital Frontier</h1>
      <p class="hero-subtitle">Building the next generation of cyber defenders through hands-on training, competitive CTFs, and a community driven by curiosity and code.</p>
      <div class="hero-cta">
        <a href="/about" class="btn btn-primary btn-arrow">Explore More</a>
        <a href="/contact" class="btn btn-secondary">Join Us</a>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="section" style="padding-top: 0; margin-top: -40px; position: relative; z-index: 2;">
    <div class="container">
      <div class="stats-bar reveal">
        <div class="stat-item">
          <div class="stat-number" data-count="50" data-suffix="+">0</div>
          <div class="stat-label">Active Members</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="3" data-suffix="+">0</div>
          <div class="stat-label">Events Conducted</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="5" data-suffix="+">0</div>
          <div class="stat-label">Workshops</div>
        </div>
        <!-- <div class="stat-item">
          <div class="stat-number" data-count="10" data-suffix="+">0</div>
          <div class="stat-label">CTF Victories</div>
        </div> -->
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="section">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <div class="section-label">About Us</div>
          <h2 class="section-title">More Than a Club,<br>A Mission</h2>
          <p class="section-desc">We are NMIMS MPSTME's first and only cybersecurity club — a community of ethical hackers, security researchers, and digital defenders. From CTF competitions to hands-on workshops, we bridge the gap between academic knowledge and industry-ready cybersecurity skills.</p>
          <a href="/about" class="btn btn-primary btn-arrow mt-24">Learn More</a>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="three-col" style="gap: 16px;">
            <div class="card" style="text-align: center; padding: 20px;">
              <!-- <div style="font-size: 28px; margin-bottom: 8px;">🏆</div> -->
              <div style="font-family: var(--font-heading); font-size: 14px; font-weight: 700;">CTF Competitions</div>
            </div>
            <div class="card" style="text-align: center; padding: 20px;">
              <!-- <div style="font-size: 28px; margin-bottom: 8px;">🔧</div> -->
              <div style="font-family: var(--font-heading); font-size: 14px; font-weight: 700;">Workshops</div>
            </div>
            <div class="card" style="text-align: center; padding: 20px;">
              <!-- <div style="font-size: 28px; margin-bottom: 8px;">🎤</div> -->
              <div style="font-family: var(--font-heading); font-size: 14px; font-weight: 700;">Guest Lectures</div>
            </div>
            <div class="card" style="text-align: center; padding: 20px;">
              <!-- <div style="font-size: 28px; margin-bottom: 8px;">🔬</div> -->
              <div style="font-family: var(--font-heading); font-size: 14px; font-weight: 700;">Research</div>
            </div>
            <div class="card" style="text-align: center; padding: 20px;">
              <!-- <div style="font-size: 28px; margin-bottom: 8px;">📢</div> -->
              <div style="font-family: var(--font-heading); font-size: 14px; font-weight: 700;">Awareness</div>
            </div>
            <div class="card" style="text-align: center; padding: 20px;">
              <!-- <div style="font-size: 28px; margin-bottom: 8px;">💻</div> -->
              <div style="font-family: var(--font-heading); font-size: 14px; font-weight: 700;">Hackathons</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Domains -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header center reveal">
        <div class="section-label">Our Domains</div>
        <h2 class="section-title">Areas of Expertise</h2>
        <p class="section-desc">We operate across all critical verticals of cybersecurity, training our members in the disciplines that matter most.</p>
      </div>
      <div class="three-col">
        <div class="card reveal">
          <!-- <div class="card-icon">🔓</div> -->
          <h3 class="card-title">Penetration Testing</h3>
          <p class="card-text">Vulnerability assessment and exploit development to identify and remediate security weaknesses.</p>
        </div>
        <div class="card reveal reveal-delay-1">
          <!-- <div class="card-icon">🔍</div> -->
          <h3 class="card-title">Digital Forensics</h3>
          <p class="card-text">Evidence acquisition and analysis techniques for cybercrime investigation and data breach response.</p>
        </div>
        <div class="card reveal reveal-delay-2">
          <!-- <div class="card-icon">🌐</div> -->
          <h3 class="card-title">Network Security</h3>
          <p class="card-text">Securing network infrastructure, intrusion detection, and traffic analysis methodologies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Preview -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Events</div>
        <h2 class="section-title">Upcoming Experiences</h2>
      </div>
      <div class="events-grid">
        {upcomingEvents.length > 0 ? (
          upcomingEvents.map(event => (
            <div class="event-card reveal">
              {event.data.image ? (
                <div class="event-card-img" style={`background-image: url('${event.data.image}'); background-size: cover; background-position: center;`}></div>
              ) : (
                <div class="event-card-img"><span>{event.data.category.toUpperCase().slice(0,3)}</span></div>
              )}
              <div class="event-card-body">
                <div class="event-card-date">{new Date(event.data.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
                <h3 class="event-card-title">{event.data.title}</h3>
                <p class="event-card-desc">{event.data.description}</p>
                <a href="/events" class="event-card-link">Learn More →</a>
              </div>
            </div>
          ))
        ) : (
          <div class="card reveal" style="grid-column: 1 / -1; text-align: center; padding: 48px 24px; border-style: dashed; border-color: var(--border);">
            <div style="font-size: 32px; margin-bottom: 16px;">⏳</div>
            <h3 class="card-title">More Events Coming Soon</h3>
            <p class="card-text text-muted">We're cooking up something exciting. Keep an eye on this space or check our past events.</p>
          </div>
        )}
      </div>
      <div class="text-center mt-32 reveal">
        <a href="/events" class="btn btn-secondary btn-arrow">View All Events</a>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="section section--alt">
    <div class="container">
      <div class="newsletter-cta reveal">
        <div class="newsletter-cta-logo"><img src="/assets/logo.png" alt="Cyber Chakravyuh"></div>
        <div>
          <h3 class="newsletter-cta-title">Stay Updated with Cyber Chakravyuh</h3>
          <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing!');">
            <label for="heroEmail">Email</label>
            <input type="email" id="heroEmail" placeholder="your.email@nmims.edu" required>
            <button type="submit">→</button>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>
