  <!-- Join the Team CTA -->
  <section class="section section--alt text-center">
    <div class="container">
      <h2 class="section-title">Want to Join the Team?</h2>
      <p class="section-desc mt-12 mb-24">We are always looking for passionate individuals to join our core committee. Keep an eye out for our next recruitment drive!</p>
      <a href="/contact" class="btn btn-primary">Contact Us</a>
    </div>
  </section>

</Layout>
