---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Collaborations — Cyber Chakravyuh" activePage="collaborations">
  <!-- Hero -->
  <section class="hero-inner">
    <div class="container">
      <div class="section-label">TOGETHER STRONGER</div>
      <h1 class="hero-title">Collaborations & Partnerships</h1>
      <p class="hero-subtitle">Building a stronger cybersecurity ecosystem through meaningful partnerships and collective growth.</p>
    </div>
  </section>

  <!-- Partners Grid -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2 class="section-title">Our Partners</h2>
        <p class="section-desc">Organizations and communities we work with to bring the best opportunities.</p>
      </div>
      <div class="collab-grid">
        <div class="collab-logo-card">
          <span>NMIMS Innovation Cell</span>
        </div>
        <div class="collab-logo-card">
          <span>Google DSC</span>
        </div>
        <div class="collab-logo-card">
          <span>Microsoft Learn</span>
        </div>
        <div class="collab-logo-card">
          <span>AWS Cloud Club</span>
        </div>
        <div class="collab-logo-card">
          <span>HackTheBox</span>
        </div>
        <div class="collab-logo-card">
          <span>TryHackMe</span>
        </div>
        <div class="collab-logo-card">
          <span>OWASP Mumbai</span>
        </div>
        <div class="collab-logo-card">
          <span>CyberPeace Foundation</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Collaborate -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header center">
        <h2 class="section-title">How We Collaborate</h2>
        <p class="section-desc">Ways we engage with our partners to foster innovation and learning.</p>
      </div>
      <div class="three-col">
        <div class="card">
          <!-- <div class="card-icon">🤝</div> -->
          <h3 class="card-title">Joint Events & Workshops</h3>
          <p class="card-text">We co-host hackathons, bootcamps, and technical workshops to provide hands-on experience and diverse perspectives to our members.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">📚</div> -->
          <h3 class="card-title">Knowledge Exchange</h3>
          <p class="card-text">We share resources, expert speakers, and training materials to elevate the quality of education and awareness in our community.</p>
        </div>
        <div class="card">
          <!-- <div class="card-icon">🏅</div> -->
          <h3 class="card-title">Sponsored Competitions</h3>
          <p class="card-text">Through industry partnerships, we organize CTFs and competitions with valuable prizes, platform access, and internship opportunities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container text-center">
      <h2 class="section-title">Partner With Us</h2>
      <p class="section-desc mb-32">Interested in collaborating with Cyber Chakravyuh? We're always looking for organizations that share our vision.</p>
      <a href="/contact" class="btn btn-primary">Get in Touch</a>
    </div>
  </section>
</Layout>
