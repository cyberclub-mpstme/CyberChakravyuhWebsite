---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNewsletters = await getCollection('newsletters');
const sorted = allNewsletters.sort((a, b) => b.data.issueNumber - a.data.issueNumber);

// Compute totals
const totalDownloads = sorted.reduce((sum, n) => sum + (n.data.downloads || 0), 0);
const totalViews = sorted.reduce((sum, n) => sum + (n.data.views || 0), 0);
const totalEditions = sorted.length;
---

<Layout title="Zero Day Newsletter — Cyber Chakravyuh" activePage="newsletter">

  <!-- Newsletter Hero with Zero Day Logo -->
  <section class="zd-hero">
    <div class="container">
      <div class="zd-hero-inner">
        <img src="/assets/zeroday-logo.png" alt="The Zero Day Newsletter" class="zd-hero-logo" />
        <p class="zd-hero-tagline">Secure Trust, Empowering Innovation</p>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="zd-stats-bar">
    <div class="container">
      <div class="zd-stats-row">
        <div class="zd-stat">
          <span class="zd-stat-number" data-count={totalEditions} data-suffix="">{totalEditions}</span>
          <span class="zd-stat-label">Editions Published</span>
        </div>
        <div class="zd-stat-divider"></div>
        <div class="zd-stat">
          <span class="zd-stat-number" data-count={totalViews} data-suffix="">{totalViews}</span>
          <span class="zd-stat-label">Total Views</span>
        </div>
        <div class="zd-stat-divider"></div>
        <div class="zd-stat">
          <span class="zd-stat-number" data-count={totalDownloads} data-suffix="">{totalDownloads}</span>
          <span class="zd-stat-label">Total Downloads</span>
        </div>
      </div>
    </div>
  </section>

  <!-- All Editions -->
  <section class="section">
    <div class="container">
      <div class="section-header center reveal">
        <div class="section-label">ALL EDITIONS</div>
        <h2 class="section-title">Browse Our Publications</h2>
      </div>

      <div class="zd-editions-grid">
        {sorted.map((issue) => (
          <div class="zd-edition-card reveal">
            <div class="zd-edition-cover">
              {issue.data.coverImage ? (
                <img src={issue.data.coverImage} alt={issue.data.title} />
              ) : (
                <div class="zd-edition-cover-placeholder">
                  <span class="zd-edition-cover-number">#{issue.data.issueNumber}</span>
                  <span class="zd-edition-cover-name">ZERO DAY</span>
                </div>
              )}
            </div>
            <div class="zd-edition-info">
              <div class="zd-edition-badge">Edition #{issue.data.issueNumber}</div>
              <h3 class="zd-edition-title">{issue.data.title}</h3>
              <p class="zd-edition-date">
                {new Date(issue.data.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <p class="zd-edition-desc">{issue.data.description}</p>
              <div class="zd-edition-meta">
                <span class="zd-edition-meta-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <span class="zd-view-count" data-edition={issue.id}>0</span> views
                </span>
                <span class="zd-edition-meta-item">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  <span class="zd-dl-count" data-edition={issue.id}>0</span> downloads
                </span>
              </div>
              <div class="zd-edition-actions">
                {issue.data.pdfFile && (
                  <a href={issue.data.pdfFile} target="_blank" rel="noopener noreferrer" class="btn btn-primary zd-btn zd-read-btn" data-edition={issue.id}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                    Read Now
                  </a>
                )}
                {issue.data.pdfFile && (
                  <a href={issue.data.pdfFile} download class="btn btn-outline zd-btn zd-download-btn" data-edition={issue.id}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Download PDF
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      {sorted.length === 0 && (
        <div class="zd-empty">
          <p>No editions published yet. The first edition of Zero Day is coming soon!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Subscribe CTA -->
  <section class="section section--alt">
    <div class="container">
      <div class="newsletter-cta reveal">
        <div class="newsletter-cta-logo">
          <img src="/assets/zeroday-logo.png" alt="Zero Day" />
        </div>
        <div>
          <h2 class="newsletter-cta-title">Subscribe to Zero Day</h2>
          <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Zero Day!');">
            <input type="email" class="form-input" placeholder="Your Email Address" required />
            <button type="submit" class="btn btn-primary">Subscribe</button>
          </form>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
(function() {
  const NAMESPACE = 'cyberchakravyuh-zeroday';

  // CountAPI helper — hit (increment) or get
  async function countHit(key) {
    try {
      const res = await fetch(`https://api.countapi.xyz/hit/${NAMESPACE}/${key}`);
      if (res.ok) { const d = await res.json(); return d.value; }
    } catch(e) {}
    // Fallback: localStorage
    const k = `zd-${key}`;
    const v = parseInt(localStorage.getItem(k) || '0') + 1;
    localStorage.setItem(k, v);
    return v;
  }

  async function countGet(key) {
    try {
      const res = await fetch(`https://api.countapi.xyz/get/${NAMESPACE}/${key}`);
      if (res.ok) { const d = await res.json(); return d.value || 0; }
    } catch(e) {}
    return parseInt(localStorage.getItem(`zd-${key}`) || '0');
  }

  document.addEventListener('DOMContentLoaded', async () => {
    // Load current counts for all editions
    const viewEls = document.querySelectorAll('.zd-view-count');
    const dlEls = document.querySelectorAll('.zd-dl-count');
    let totalViews = 0, totalDownloads = 0;

    for (const el of viewEls) {
      const ed = el.dataset.edition;
      const count = await countGet(`views-${ed}`);
      el.textContent = count;
      totalViews += count;
    }
    for (const el of dlEls) {
      const ed = el.dataset.edition;
      const count = await countGet(`downloads-${ed}`);
      el.textContent = count;
      totalDownloads += count;
    }

    // Update stats bar totals
    const statNums = document.querySelectorAll('.zd-stat-number');
    if (statNums.length >= 3) {
      statNums[1].textContent = totalViews;
      statNums[2].textContent = totalDownloads;
    }

    // Helper to increment total stat visually
    const incrementTotal = (index) => {
      const statNums = document.querySelectorAll('.zd-stat-number');
      if (statNums.length > index) {
        statNums[index].textContent = parseInt(statNums[index].textContent || '0') + 1;
      }
    };

    // Read Now click → increment views
    document.querySelectorAll('.zd-read-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const ed = btn.dataset.edition;
        const newCount = await countHit(`views-${ed}`);
        const el = document.querySelector(`.zd-view-count[data-edition="${ed}"]`);
        if (el) el.textContent = newCount;
        incrementTotal(1); // Index 1 is total views
      });
    });

    // Download click → increment downloads
    document.querySelectorAll('.zd-download-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const ed = btn.dataset.edition;
        const newCount = await countHit(`downloads-${ed}`);
        const el = document.querySelector(`.zd-dl-count[data-edition="${ed}"]`);
        if (el) el.textContent = newCount;
        incrementTotal(2); // Index 2 is total downloads
      });
    });
  });
})();
</script>

</Layout>
